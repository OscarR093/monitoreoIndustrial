# Modo de despliegue: "cloud" o "intranet"
DEPLOYMENT_MODE=intranet

# MQTT
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTTS_PORT=8883
MQTT_USE_TLS=false
MQTT_USER=bridge_user
MQTT_PASS=changeme

# Bridge
REAL_TIME_INTERVAL=2
HISTORIC_INTERVAL=1200
PLANTA=p1
AREAS=a1
SENSOR_COUNT=4
SIMULATION=true
PLC_HOST=192.168.1.100
PLC_PORT=502
PLC_UNIT_ID=1

# JWT
JWT_SECRET=super-secret-key-change-in-production
JWT_EXPIRES_IN=1h

# SuperAdmin (creado automáticamente al iniciar la API)
SUPER_ADMIN_USERNAME=admin
SUPER_ADMIN_PASSWORD=admin123

# Cloud (solo si DEPLOYMENT_MODE=cloud)
DOMAIN_URL=cliente.dominio.com
LETSENCRYPT_EMAIL=admin@dominio.com
